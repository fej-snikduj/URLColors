{
  "name": "URLColors",
  "short_name": "URLColors",
  "description": "Know your environment. A chrome extension that adds a colored border around websites that match user inputted preferences.",
  "version": "3.0.1",
  "manifest_version": 3,
  "host_permissions": ["https://*/*"],
  "permissions": ["storage", "tabs", "scripting"],
  "background": {
    "service_worker": "urlColorsServiceWorker.js"
  },
  "action": {
    "default_popup": "urlColorsPopup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["urlColorsContentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

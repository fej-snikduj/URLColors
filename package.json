{
  "name": "urlcolors",
  "version": "3.1.6",
  "private": true,
  "type": "module",
  "description": "Browser extension that highlights the body of a webpage with a colored border for URLs that match user settings.",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:manifests": "node scripts/check-manifests.mjs",
    "check:safari": "node scripts/check-safari-resources.mjs",
    "build:chrome": "node scripts/build-package.mjs chrome",
    "build:firefox": "node scripts/build-package.mjs firefox",
    "build": "npm run build:chrome && npm run build:firefox"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "eslint-config-prettier": "^9.1.0"
  }
}

{
  "name": "URLColors",
  "short_name": "URLColors",
  "description": "Know your environment. Adds a colored border around tabs whose URL matches your rules.",
  "version": "3.1.5",
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "urlcolors@urlcolors.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "host_permissions": ["https://*/*"],
  "permissions": ["storage", "tabs", "scripting"],
  "background": {
    "scripts": ["urlColorsServiceWorker.js"]
  },
  "action": {
    "default_popup": "urlColorsPopup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["urlColorsContentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
